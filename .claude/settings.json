{
  "model": "claude-sonnet-4-6",
  "alwaysThinkingEnabled": false,
  "autoCompactThreshold": 80,
  "enableAllProjectMcpServers": true,
  "respectGitignore": true,
  "plansDirectory": "./reports",
  "outputStyle": "Explanatory",
  "permissions": {
    "allow": [
      "Bash(pnpm *)",
      "Bash(bun *)",
      "Bash(bunx *)",
      "Bash(npx *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git status)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git fetch *)",
      "Bash(git pull *)",
      "Bash(git stash list)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(find *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(wc *)",
      "Bash(jq *)",
      "Bash(node *)",
      "Bash(ss *)",
      "Bash(curl -s *)",
      "Read(**)",
      "Edit(**)",
      "Write(**)",
      "Glob(**)",
      "Grep(**)",
      "WebFetch(*)",
      "WebSearch(*)"
    ],
    "ask": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git reset *)",
      "Bash(git checkout *)",
      "Bash(git rebase *)",
      "Bash(rm *)",
      "Bash(rmdir *)",
      "Bash(npm publish *)",
      "Bash(pnpm publish *)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Bash(git push --force *)",
      "Bash(git reset --hard *)"
    ]
  },
  "env": {
    "NODE_ENV": "development"
  }
}
